{"v":1,"id":"01KYZ6JC5X63C0A4HMJD5ZQ6Q4","ts":"2026-08-01T17:39:52.638Z","initiative":"record-integrity","session":"7e987def-15b6-4689-97c7-1b7157f9289d","source":"hook","actor":"agent","user":"dev@jithin.io","type":"command_run","payload":{"cmd":"python3 - <<'PY'\nimport json,glob,collections\nstarts=collections.defaultdict(list)\nfor f in glob.glob('.sofar/initiatives/*/events.jsonl'):\n    slug=f.split('/')[2]\n    for line in open(f):\n        line=line.strip()\n        if not line: continue\n        try: e=json.loads(line)\n        except: continue\n        if e.get('type')=='session_started':\n            starts[e.get('session')].append((slug,e.get('source'),e.get('ts')))\nmulti={s:v for s,v in starts.items() if len(v)>1}\nprint(f\"sessions with session_started in >1 initiative: {len(multi)}\\n\")\nfor s,v in sorted(multi.items()):\n    v.sort(key=lambda x:x[2])\n    print(f\"  {s[:12]:14} \" + \" | \".join(f\"{sl}({src})\" for sl,src,_ in v))\nprint(\"\\nsource of the SECOND+ registration (the suspicious one):\")\nprint(collections.Counter(src for v in multi.values() for _,src,_ in sorted(v,key=lambda x:x[2])[1:]))\nPY"}}
